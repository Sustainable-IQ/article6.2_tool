{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "article6-ca-workbench",
  "account_id": "1b72e4972bf0dd6b7818dd04284725ab",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Static front end. Requests that do not match /api/* are served from ./public.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // D1. Create the database first with:  npx wrangler d1 create article6
  // then paste the returned database_id below. Until then the Worker returns 503
  // on /api/* and the front end falls back to its embedded snapshot, so the site
  // still works before the database exists.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "article6",
      "database_id": "9fb0ecbc-f40e-4409-b3cb-693bd83565b2"
    }
  ],

  "observability": { "enabled": true }
}
